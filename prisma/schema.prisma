generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String @id @default(uuid())

  fullName              String
  email                 String @unique
  phone                 String @unique
  password              String

  role                  UserRole @default(USER)

  verificationStatus    VerificationStatus @default(NOT_STARTED)

  emailVerified         Boolean @default(false)
  phoneVerified         Boolean @default(false)

  trustScore            Int @default(50)

  nationalId            String?
  faceImage             String?
  selfieImage           String?

  createdAt             DateTime @default(now())

  wallet                Wallet?
  products              Product[]
}

model Wallet {
  id      String @id @default(uuid())
  balance Float  @default(0)

  userId  String @unique

  user    User @relation(
    fields: [userId],
    references: [id]
  )
}
model Wallet {
  id      String @id @default(uuid())
  balance Float @default(0)

  userId  String @unique
  user    User @relation(fields: [userId], references: [id])
}
model Product {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  category    String
  imageUrl    String?
  location    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  sellerId    String
 seller User @relation(fields: [sellerId], references: [id])
model Transaction {
  id        String   @id @default(uuid())
  amount    Float
  status    String   @default("PENDING")
  buyerId   String
  sellerId  String
  productId String
  createdAt DateTime @default(now())
}

model Escrow {
  id            String   @id @default(uuid())
  amount        Float
  status        String   @default("HELD")
  buyerId       String
  sellerId      String
  transactionId String   @unique
  createdAt     DateTime @default(now())
}

model Dispute {
  id            String   @id @default(uuid())
  reason        String
  status        String   @default("OPEN")
  transactionId String   @unique
  createdAt     DateTime @default(now())
}

model Payment {
  id        String   @id @default(uuid())
  reference String   @unique
  amount    Float
  status    String
  userId    String
  createdAt DateTime @default(now())
}

model Withdrawal {
  id            String   @id @default(uuid())
  amount        Float
  accountName   String
  accountNumber String
  bankCode      String
  status        String   @default("PENDING")
  userId        String
  createdAt     DateTime @default(now())
}

enum UserRole {
  USER
  VERIFIED
  MERCHANT
  ADMIN
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REFUNDED
  DISPUTED
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}
